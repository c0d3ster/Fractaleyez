{
  "name": "beatsense",
  "version": "0.0.0",
  "private": true,
  "description": "Real-time music analysis: beats, tempo, the bar grid, song sections, drum hits, risers and sweeps, from five band levels a frame.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@fractaleyez/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test --fix",
    "test": "vitest run"
  },
  "keywords": [
    "audio",
    "music",
    "beat-detection",
    "tempo",
    "web-audio"
  ],
  "author": "Cody Douglass",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c0d3ster/Fractaleyez.git",
    "directory": "packages/beatsense"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  }
}
