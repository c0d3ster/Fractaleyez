{
  "buildCommand": "pnpm build",
  "outputDirectory": "public",
  "framework": null,
  "crons": [
    {
      "path": "/api/ping",
      "schedule": "0 0 */5 * *"
    }
  ],
  "rewrites": [
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ]
}
